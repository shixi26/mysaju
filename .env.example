MY_HOST="example.com"

# 한국천문연구원 LunPhInfoService API (공공데이터포털 발급)
# 서버/스크립트 전용 - 클라이언트에 노출되지 않음. .env.local에만 실제 키 저장
# GitHub Pages 배포 시 API 미제공 → 로컬 solarTerms.json으로 계산됨
KASI_SERVICE_KEY="your-service-key"
